<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-feature android:name="android.hardware.usb.host" />
    <!-- Required for some root ops if not purely su-based (though su bypasses this) -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BootMaster"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <activity android:name=".ui.FileBrowserActivity"
            android:label="File Browser"
            android:parentActivityName=".ui.MainActivity"/>

        <activity android:name=".ui.DownloadActivity"
            android:label="Download ISOs"
            android:parentActivityName=".ui.MainActivity"/>

        <activity android:name=".ui.FormatActivity"
            android:label="Quick Format"
            android:parentActivityName=".ui.MainActivity"/>

        <!-- WorkManager definition is auto-merged, but good to be aware -->
    </application>

</manifest>
